DROPEA_MARKET=CL
DROPEA_API_KEY=
DROPEA_SIGNING_SECRET=
PORT=3001
# For HTTPS reverse-proxy hosting only. Authenticate all routes except the signed webhook.
PUBLIC_ORIGIN=
# Optional: 32 random bytes encoded as Base64; enables encrypted persistent connections.
CONNECTION_ENCRYPTION_KEY=
ADMIN_USERNAME=admin
# Required for production; generate with hashPassword from server/auth.js.
ADMIN_PASSWORD_HASH=

# Optional offline visitor geolocation database (MMDB).
LIVE_GEO_DATABASE=

# Optional owner-only connection to an existing REAL campaign; never ship these values to members.
LIVE_CAMPAIGN_REPORT_URL=
LIVE_CAMPAIGN_TOKEN=
LIVE_CAMPAIGN_OWNER=
LIVE_CAMPAIGN_LANDING_ID=
